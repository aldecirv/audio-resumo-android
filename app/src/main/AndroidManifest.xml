<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".AudioResumoApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher_legacy"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_legacy"
        android:supportsRtl="true"
        android:theme="@style/Theme.AudioResumo">

        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AudioResumo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.MainActivity" android:exported="false" />
        <activity android:name=".ui.SummaryDetailActivity" android:exported="false" />
        <activity android:name=".ui.PlayerActivity" android:exported="false" />
        <activity android:name=".ui.MindMapActivity" android:exported="false" />
        <activity android:name=".ui.FlashcardsActivity" android:exported="false" />
        <activity android:name=".ui.QuizActivity" android:exported="false" />
        <activity android:name=".ui.ReviewPlanActivity" android:exported="false" />
        <activity android:name=".ui.BookDetailActivity" android:exported="false" />
        <activity android:name=".ui.BookReaderActivity" android:exported="false" />
        <activity android:name=".ui.BookQaActivity" android:exported="false" />
        <activity android:name=".ui.BookImportActivity" android:exported="false" />

        <service
            android:name=".service.SpeechService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".service.BookProcessingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="book_summary_processing" />
        </service>
    </application>
</manifest>
