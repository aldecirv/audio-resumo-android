<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            style="@style/TextAppearance.Audio.H3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Livro" />

        <ImageButton
            android:id="@+id/favorite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favoritar"
            android:padding="11dp"
            android:src="@drawable/ic_favorite"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/more"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mais opções"
            android:padding="11dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.audioresumo.app.ui.widgets.CoverView
                    android:id="@+id/cover"
                    android:layout_width="112dp"
                    android:layout_height="132dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        style="@style/TextAppearance.Audio.H1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:text="Livro"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/author"
                        style="@style/TextAppearance.Audio.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Autor" />

                    <TextView
                        android:id="@+id/meta"
                        style="@style/TextAppearance.Audio.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="EPUB · 12 capítulos · 45 mil palavras"
                        android:textColor="@color/text_tertiary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/progressCard"
                style="@style/Widget.Audio.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:strokeColor="#4D8B5CF6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="13dp">

                    <TextView
                        android:id="@+id/progressLabel"
                        style="@style/TextAppearance.Audio.BodyStrong"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Processando livro..."
                        android:textSize="12.5sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:indicatorColor="@color/brand"
                        app:trackColor="@color/card_alt"
                        app:trackCornerRadius="3dp"
                        app:trackThickness="5dp" />

                    <TextView
                        android:id="@+id/progressMessage"
                        style="@style/TextAppearance.Audio.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Lendo capítulos..."
                        android:textSize="10.5sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/cancelProcessing"
                        style="@style/Widget.Audio.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="2dp"
                        android:text="Cancelar processamento"
                        android:textColor="@color/rose"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSummaryBook"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gradient_button"
                    android:fontFamily="@font/jakarta_semibold"
                    android:text="Resumo do livro"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAsk"
                    style="@style/Widget.Audio.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Perguntar"
                    android:textSize="12sp"
                    app:icon="@drawable/ic_search"
                    app:iconSize="17dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueReading"
                style="@style/Widget.Audio.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:text="Continuar leitura"
                android:textSize="11.5sp"
                app:icon="@drawable/ic_menu_book"
                app:iconSize="17dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summaryCard"
                style="@style/Widget.Audio.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:strokeColor="#4D8B5CF6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/TextAppearance.Audio.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RESUMO DO LIVRO"
                        android:textColor="@color/brand" />

                    <TextView
                        android:id="@+id/summaryTitle"
                        style="@style/TextAppearance.Audio.H3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Resumo" />

                    <TextView
                        android:id="@+id/summarySubtitle"
                        style="@style/TextAppearance.Audio.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gerado a partir do livro completo" />

                    <TextView
                        android:id="@+id/summaryPreview"
                        style="@style/TextAppearance.Audio.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:maxLines="4"
                        android:text="..." />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenSummary"
                            style="@style/Widget.Audio.Button"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="Abrir resumo"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnListenSummary"
                            style="@style/Widget.Audio.Button.Outlined"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Ouvir"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextAppearance.Audio.H2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Capítulos"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/chapterCount"
                    style="@style/TextAppearance.Audio.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 capítulos" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chapterList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
