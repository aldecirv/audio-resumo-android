<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/greetingLabel"
                    style="@style/TextAppearance.Audio.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BOAS-VINDAS, LEITOR"
                    android:textColor="@color/brand" />

                <TextView
                    style="@style/TextAppearance.Audio.H1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="O que você quer aprender hoje?"
                    android:textSize="23sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/streakPill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_local_fire_department"
                    app:tint="@color/amber" />

                <TextView
                    android:id="@+id/streakText"
                    style="@style/TextAppearance.Audio.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="7 dias"
                    android:textColor="@color/amber"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/continueCard"
            style="@style/Widget.Audio.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="@color/card"
            app:strokeColor="#3D8B5CF6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_headphones"
                        app:tint="@color/brand" />

                    <TextView
                        style="@style/TextAppearance.Audio.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="Continuar de onde parou"
                        android:textColor="@color/brand" />

                    <TextView
                        android:id="@+id/continuePercent"
                        style="@style/TextAppearance.Audio.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="38% concluído" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.audioresumo.app.ui.widgets.CoverView
                        android:id="@+id/continueCover"
                        android:layout_width="54dp"
                        android:layout_height="58dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/continueTitle"
                            style="@style/TextAppearance.Audio.BodyStrong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Hábitos Atômicos" />

                        <TextView
                            android:id="@+id/continueAuthor"
                            style="@style/TextAppearance.Audio.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="James Clear" />

                        <TextView
                            android:id="@+id/continueMeta"
                            style="@style/TextAppearance.Audio.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Produtividade · 5 min"
                            android:textColor="@color/brand"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/continuePlay"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_gradient_primary"
                        android:contentDescription="Continuar reprodução"
                        android:padding="12dp"
                        android:src="@drawable/ic_play_arrow"
                        app:tint="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_auto_awesome"
                app:tint="@color/amber" />

            <TextView
                style="@style/TextAppearance.Audio.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:text="Destaque da semana"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/featuredCard"
            style="@style/Widget.Audio.Card"
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="26dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:id="@+id/featuredBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_hero"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/featuredCategory"
                        style="@style/TextAppearance.Audio.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="5dp"
                        android:text="PRODUTIVIDADE"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/featuredTitle"
                        style="@style/TextAppearance.Audio.H1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Hábitos Atômicos"
                        android:textSize="25sp" />

                    <TextView
                        android:id="@+id/featuredSubtitle"
                        style="@style/TextAppearance.Audio.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Mudanças Minúsculas, Resultados Notáveis"
                        android:textColor="#E9DBFF"
                        android:textSize="11.5sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/featuredMeta"
                            style="@style/TextAppearance.Audio.Mono"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="James Clear · 5 min · ★ 4.9"
                            android:textColor="#E9DBFF"
                            android:textSize="10.5sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/featuredPlay"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_pill_white"
                            android:fontFamily="@font/jakarta_semibold"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="▶  Ouvir agora"
                            android:textAllCaps="false"
                            android:textColor="@color/brand_dark"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_trending_up"
                app:tint="@color/brand" />

            <TextView
                style="@style/TextAppearance.Audio.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:text="Mais ouvidos da semana"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/trendingAll"
                style="@style/TextAppearance.Audio.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver todos"
                android:textColor="@color/brand" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trendingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/ic_timer"
                app:tint="@color/emerald" />

            <TextView
                style="@style/TextAppearance.Audio.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:text="Para ouvir em 5 minutos"
                android:textSize="15sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/quickList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            style="@style/TextAppearance.Audio.H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Explore por categoria"
            android:textSize="15sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/categoryGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp"
            app:singleSelection="false" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
