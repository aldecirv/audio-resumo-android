<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Audio.Card.Soft"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/number"
            style="@style/TextAppearance.Audio.BodyStrong"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_soft"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/brand"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                style="@style/TextAppearance.Audio.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Capítulo"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/meta"
                style="@style/TextAppearance.Audio.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3.200 palavras · sem resumo"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRead"
                    style="@style/Widget.Audio.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="8dp"
                    android:text="Ler / ouvir"
                    android:textSize="10.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSummarize"
                    style="@style/Widget.Audio.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp"
                    android:text="Resumir"
                    android:textSize="10.5sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSummary"
                    style="@style/Widget.Audio.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="0dp"
                    android:text="Abrir resumo"
                    android:textSize="10.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/brand" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
