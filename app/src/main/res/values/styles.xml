<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Audio.H1" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="TextAppearance.Audio.H2" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="TextAppearance.Audio.H3" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
    </style>
    <style name="TextAppearance.Audio.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:fontFamily">@font/jakarta_regular</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="TextAppearance.Audio.BodyStrong" parent="TextAppearance.Audio.Body">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
    </style>
    <style name="TextAppearance.Audio.Caption" parent="TextAppearance.Audio.Body">
        <item name="android:textSize">11.5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">1dp</item>
    </style>
    <style name="TextAppearance.Audio.Label" parent="TextAppearance.Audio.Caption">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="android:letterSpacing">0.09</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.Audio.Mono" parent="TextAppearance.Audio.Caption">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.Audio.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Widget.Audio.Card.Soft" parent="Widget.Audio.Card">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">18dp</item>
    </style>

    <style name="Widget.Audio.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.Audio.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="iconTint">@color/text_primary</item>
    </style>

    <style name="Widget.Audio.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/brand</item>
    </style>

    <style name="Widget.Audio.Input" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/brand</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/text_tertiary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <style name="Widget.Audio.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/card</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11.5sp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">34dp</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/divider</item>
    </style>
</resources>
